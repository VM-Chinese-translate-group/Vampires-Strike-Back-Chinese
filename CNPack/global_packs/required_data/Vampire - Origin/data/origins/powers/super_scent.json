{
  "name": "power.origins.super_scent.name",
  "description": "power.origins.super_scent.description",
  "hidden": false,
  "type": "origins:multiple",

  "sneaking_steps": {
    "type": "origins:action_over_time",
    "interval": 19,
    "entity_action": {
            "type": "origins:execute_command",
            "command": "effect give @e[type=#vampires:humans,limit=1,sort=nearest] minecraft:glowing 1 0 true",
            "permission_level": 4
        },
    "condition": {
      "type": "origins:and",
      "conditions": [
        { "type": "origins:on_block" },
        { "type": "origins:sneaking" }
      ]
    }
  },

  "blinding": {
    "type": "origins:action_over_time",
    "interval": 19,
    "entity_action":
        {
            "type": "origins:execute_command",
            "command": "effect give @p minecraft:darkness 3 0 true",
            "permission_level": 4
        },
    "condition": {
      "type": "origins:and",
      "conditions": [
        { "type": "origins:on_block" },
        { "type": "origins:sneaking" }
      ]
    }
  }
}